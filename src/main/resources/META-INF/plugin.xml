<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>net.postchain.rellide.jetbrains</id>
    <name>Rell</name>
    <vendor email="devex@chromaway.com" url="https://chromaway.com">ChromaWay</vendor>
    <description>Rell blockchain programming language plugin</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <resource-bundle>messages.RellBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Rell file"
                implementationClass="net.postchain.rellide.jetbrains.language.RellFileType"
                fieldName="INSTANCE"
                language="Rell"
                extensions="rell"/>

        <notificationGroup id="Rell" displayType="BALLOON" key="notification.group.rell"/>

        <lang.parserDefinition
                language="Rell"
                implementationClass="net.postchain.rellide.jetbrains.language.RellParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="Rell"
                implementationClass="net.postchain.rellide.jetbrains.language.RellSyntaxHighlighterFactory"/>

        <colorSettingsPage
                implementation="net.postchain.rellide.jetbrains.colors.RellColorSettingsPage"/>

        <!-- Commenter -->
        <lang.commenter language="Rell" implementationClass="net.postchain.rellide.jetbrains.language.RellCommenter"/>

        <!-- Brace Matcher -->
        <lang.braceMatcher language="Rell" implementationClass="net.postchain.rellide.jetbrains.language.RellPairedBraceMatcher"/>

        <!-- Quote Handlers -->
        <lang.quoteHandler language="Rell" implementationClass="net.postchain.rellide.jetbrains.language.RellQuoteTokenHandler"/>

        <!-- Folding -->
        <lang.foldingBuilder language="Rell" implementationClass="net.postchain.rellide.jetbrains.language.RellFoldingBuilder"/>

        <!-- LSP textDocument/signatureHelp -->
        <codeInsight.parameterInfo
                language="Rell"
                implementationClass="com.redhat.devtools.lsp4ij.features.signatureHelp.LSPParameterInfoHandler"/>

        <!-- LSP textDocument/documentSymbol -->
        <lang.psiStructureViewFactory
                language="Rell"
                implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>


        <!-- Code style -->
        <codeStyleSettingsProvider implementation="net.postchain.rellide.jetbrains.formatting.RellCodeStyleSettingsProvider"/>
        <langCodeStyleSettingsProvider
                implementation="net.postchain.rellide.jetbrains.formatting.RellLanguageCodeStyleSettingsProvider"/>

        <!-- Enter handler  -->
        <enterHandlerDelegate implementation="net.postchain.rellide.jetbrains.lsp4ij.RellEnterHandler" />

        <!-- Spellchecking -->
        <spellchecker.support language="Rell" implementationClass="net.postchain.rellide.jetbrains.spellchecking.RellSpellcheckingStrategy"/>

        <!-- Custom icons -->
        <iconProvider implementation="net.postchain.rellide.jetbrains.icons.ChromiaYmlIconProvider" />

        <!-- File templates -->
        <internalFileTemplate name="Rell File"/>
        <internalFileTemplate name="Rell Entity"/>
        <internalFileTemplate name="Rell Struct"/>
        <internalFileTemplate name="Rell Object"/>
        <internalFileTemplate name="Rell Enum"/>

        <!-- Rell plugin settings -->
        <applicationConfigurable parentId="tools" instance="net.postchain.rellide.jetbrains.settings.RellPluginSettingsConfigurable"
                                 id="net.postchain.rellide.jetbrains.settings.RellPluginSettingsConfigurable"
                                 displayName="Rell"/>
        <applicationService serviceImplementation="net.postchain.rellide.jetbrains.settings.RellPluginSettingsState"/>

        <!-- Plugin replacement -->
        <pluginReplacement implementation="net.postchain.rellide.jetbrains.replacement.RellPluginReplacement" />

        <!-- Chromia Tool Window -->
        <toolWindow id="Chromia"
                    anchor="right" 
                    factoryClass="net.postchain.rellide.jetbrains.toolwindow.ChromiaToolWindowFactory"
                    icon="/icons/chromia-big.png"/>

        <!-- Run Configuration Types -->
        <configurationType implementation="net.postchain.rellide.jetbrains.testing.RellTestConfigurationType"/>

        <!-- Gutter icon provider -->
        <codeInsight.lineMarkerProvider
                language="Rell"
                implementationClass="net.postchain.rellide.jetbrains.testing.RellTestLineMarkerProvider"/>

        <testFinder implementation="net.postchain.rellide.jetbrains.testing.RellTestFinder"/>

        <errorHandler implementation="net.postchain.rellide.jetbrains.sentry.SentryReportSubmitter"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="rellLanguageServer"
                name="Rell Language Server"
                factoryClass="net.postchain.rellide.jetbrains.lsp4ij.RellLanguageServerFactory">
            <description><![CDATA[
            Rell Language Server
        ]]>
            </description>
        </server>

        <languageMapping language="Rell"
                         serverId="rellLanguageServer"
                         languageId="Rell"/>

        <semanticTokensColorsProvider
                serverId="rellLanguageServer"
                class="net.postchain.rellide.jetbrains.lsp4ij.RellSemanticTokensColorProvider" />
    </extensions>


    <actions>
        <action id="rell.file.create"
                class="net.postchain.rellide.jetbrains.actions.RellCreateFileAction"
                text="Rell file" description="Create new Rell file">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewDir"/>
        </action>
        <action id="rell.invalidate.cache"
                class="net.postchain.rellide.jetbrains.actions.RellInvalidateCacheAction"
                text="Rell: Invalidate Cache" description="Remove the Rell language server cache locally">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt I"/>
        </action>
        
        <!-- Test Runner Actions -->
        <action id="rell.test.run"
                class="net.postchain.rellide.jetbrains.testing.actions.RunRellTestAction"
                text="Run Rell Test" description="Run the selected Rell test file"
                icon="/icons/rell.png">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="RunContextGroup"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="RunContextGroup"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift F10"/>
        </action>
    </actions>
</idea-plugin>
