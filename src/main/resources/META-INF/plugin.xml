<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>net.postchain.rellide.jetbrains</id>
    <name>Rell</name>
    <vendor email="devex@chromaway.com" url="https://chromaway.com">ChromaWay</vendor>
    <description>Rell blockchain programming language plugin</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <!-- .rell_lint and .rell_format use EditorConfig syntax; associating them with the bundled
         EditorConfig plugin's file type gives them highlighting and structure support. -->
    <depends optional="true" config-file="rell-withEditorConfig.xml">org.editorconfig.editorconfigjetbrains</depends>

    <resource-bundle>messages.RellBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Rell file"
                implementationClass="net.postchain.rellide.jetbrains.language.RellFileType"
                fieldName="INSTANCE"
                language="Rell"
                extensions="rell"/>

        <notificationGroup id="Rell" displayType="BALLOON" key="notification.group.rell"/>

        <lang.parserDefinition
                language="Rell"
                implementationClass="net.postchain.rellide.jetbrains.language.RellParserDefinition"/>

        <!-- The language server owns syntax diagnostics; PSI errors would duplicate them with raw
             ANTLR messages. The filter keeps them only where no server runs. -->
        <highlightErrorFilter
                implementation="net.postchain.rellide.jetbrains.language.RellSyntaxErrorFilter"/>

        <lang.syntaxHighlighterFactory
                language="Rell"
                implementationClass="net.postchain.rellide.jetbrains.language.RellSyntaxHighlighterFactory"/>

        <colorSettingsPage
                implementation="net.postchain.rellide.jetbrains.colors.RellColorSettingsPage"/>

        <!-- Commenter -->
        <lang.commenter language="Rell" implementationClass="net.postchain.rellide.jetbrains.language.RellCommenter"/>

        <!-- Brace Matcher -->
        <lang.braceMatcher language="Rell"
                           implementationClass="net.postchain.rellide.jetbrains.language.RellPairedBraceMatcher"/>

        <!-- Quote Handlers -->
        <lang.quoteHandler language="Rell"
                           implementationClass="net.postchain.rellide.jetbrains.language.RellQuoteTokenHandler"/>

        <!-- Folding -->
        <lang.foldingBuilder language="Rell"
                             implementationClass="net.postchain.rellide.jetbrains.language.RellFoldingBuilder"/>

        <!-- Per-version Rell language servers (docs/COMPATIBILITY.md): the provider routes each
             file to the server of its chromia.yml-declared version — and to none below the
             compatibility floor. Signature help, structure view, semantic tokens, and the rest of
             the LSP feature set come with the platform integration. -->
        <platform.lsp.integrationProvider
                implementation="net.postchain.rellide.jetbrains.lsp.RellLspIntegrationProvider"/>

        <!-- Server diagnostics for batch runs (Code | Inspect Code); the editor pass gets them
             from the platform's LSP highlighting instead -->
        <localInspection language="Rell"
                         shortName="RellLspDiagnostics"
                         displayName="Language server diagnostics"
                         groupName="Rell"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="net.postchain.rellide.jetbrains.lsp.RellLspDiagnosticsInspection"/>

        <!-- Code style -->
        <codeStyleSettingsProvider
                implementation="net.postchain.rellide.jetbrains.formatting.RellCodeStyleSettingsProvider"/>
        <langCodeStyleSettingsProvider
                implementation="net.postchain.rellide.jetbrains.formatting.RellLanguageCodeStyleSettingsProvider"/>

        <!-- Enter handler  -->
        <enterHandlerDelegate implementation="net.postchain.rellide.jetbrains.lsp.RellEnterHandler"/>

        <!-- Spellchecking -->
        <spellchecker.support language="Rell"
                              implementationClass="net.postchain.rellide.jetbrains.spellchecking.RellSpellcheckingStrategy"/>

        <!-- Version-exact syntax errors for projects on older supported Rell versions -->
        <externalAnnotator language="Rell"
                           implementationClass="net.postchain.rellide.jetbrains.chromia.RellVersionSyntaxAnnotator"/>

        <!-- Banners for unsupported (below the compatibility floor) and newer-than-known Rell versions -->
        <editorNotificationProvider
                implementation="net.postchain.rellide.jetbrains.chromia.RellVersionEditorNotificationProvider"/>

        <!-- Save-and-reload bar on chromia.yml while an edited rellVersion is unsaved -->
        <editorNotificationProvider
                implementation="net.postchain.rellide.jetbrains.chromia.ChromiaConfigReloadNotificationProvider"/>
        <postStartupActivity implementation="net.postchain.rellide.jetbrains.chromia.ChromiaConfigDocumentTracker"/>
        <editorNotificationProvider
                implementation="net.postchain.rellide.jetbrains.editorconfig.RellConfigReloadNotificationProvider"/>
        <postStartupActivity implementation="net.postchain.rellide.jetbrains.editorconfig.RellConfigDocumentTracker"/>

        <!-- Active Chromia settings file of the current file, switchable in one click -->
        <!-- Sits with the other per-file property widgets; "LineSeparator" is the platform's own
             extension id (the widget showing LF/CRLF), not a made-up name. -->
        <statusBarWidgetFactory id="RellChromiaSettingsFile"
                                implementation="net.postchain.rellide.jetbrains.chromia.ChromiaSettingsStatusBarWidgetFactory"
                                order="before LineSeparator"/>

        <!-- Custom icons -->
        <iconProvider implementation="net.postchain.rellide.jetbrains.icons.ChromiaYmlIconProvider"/>
        <iconProvider implementation="net.postchain.rellide.jetbrains.projectview.RellDirectoryIconProvider"/>

        <!-- Module namespace next to each directory in a Rell source tree -->
        <projectViewNodeDecorator implementation="net.postchain.rellide.jetbrains.projectview.RellModulePathDecorator"/>

        <!-- File templates -->
        <internalFileTemplate name="Rell File"/>
        <internalFileTemplate name="Rell Entity"/>
        <internalFileTemplate name="Rell Struct"/>
        <internalFileTemplate name="Rell Object"/>
        <internalFileTemplate name="Rell Enum"/>

        <!-- Rell plugin settings -->
        <applicationConfigurable parentId="tools"
                                 instance="net.postchain.rellide.jetbrains.settings.RellPluginSettingsConfigurable"
                                 id="net.postchain.rellide.jetbrains.settings.RellPluginSettingsConfigurable"
                                 displayName="Rell"/>
        <applicationService serviceImplementation="net.postchain.rellide.jetbrains.settings.RellPluginSettingsState"/>

        <!-- Plugin replacement -->
        <pluginReplacement implementation="net.postchain.rellide.jetbrains.replacement.RellPluginReplacement"/>

        <!-- Chromia Tool Window -->
        <toolWindow id="Chromia"
                    anchor="right"
                    factoryClass="net.postchain.rellide.jetbrains.toolwindow.ChromiaToolWindowFactory"
                    icon="/icons/chromia-big.png"/>

        <!-- Chromia project generator in File | New | Project -->
        <moduleBuilder builderClass="net.postchain.rellide.jetbrains.projectwizard.ChromiaModuleBuilder"/>

        <!-- Run Configuration Types -->
        <configurationType implementation="net.postchain.rellide.jetbrains.testing.RellTestConfigurationType"/>

        <!-- Gutter icon provider -->
        <codeInsight.lineMarkerProvider
                language="Rell"
                implementationClass="net.postchain.rellide.jetbrains.testing.RellTestLineMarkerProvider"/>

        <testFinder implementation="net.postchain.rellide.jetbrains.testing.RellTestFinder"/>

        <errorHandler implementation="net.postchain.rellide.jetbrains.sentry.SentryReportSubmitter"/>

        <postStartupActivity implementation="net.postchain.rellide.jetbrains.lsp.RellInlayHintsStartupActivity"/>
    </extensions>

    <projectListeners>
        <listener class="net.postchain.rellide.jetbrains.chromia.ChromiaConfigChangeListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <actions>
        <action id="rell.file.create"
                class="net.postchain.rellide.jetbrains.actions.RellCreateFileAction"
                text="Rell File" description="Create new Rell file">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewDir"/>
        </action>
        <action id="rell.invalidate.cache"
                class="net.postchain.rellide.jetbrains.actions.RellInvalidateCacheAction"
                text="Rell: Invalidate Cache" description="Remove the Rell language server cache locally">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt I"/>
        </action>
        <action id="rell.feature.add"
                class="net.postchain.rellide.jetbrains.actions.RellAddToProjectAction"
                text="Rell: Add To Project" description="Adds feature support to the current project">
            <keyboard-shortcut keymap="$default" first-keystroke="control shift F11"/>
        </action>

        <!-- Test Runner Actions -->
        <action id="rell.test.run"
                class="net.postchain.rellide.jetbrains.testing.actions.RunRellTestAction"
                text="Run Rell Test" description="Run the selected Rell test file"
                icon="/icons/rell.png">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="RunContextGroup"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="RunContextGroup"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift F10"/>
        </action>
    </actions>
</idea-plugin>
